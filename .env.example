# .env — copy this to .env and fill in values (never commit .env to git)
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# SQLite (default for dev — leave DATABASE_URL blank)
DATABASE_URL=

# MySQL (uncomment for staging/prod)
# DATABASE_URL=mysql://user:password@localhost:3306/classsync

# Media / Static
MEDIA_ROOT=media/

# Firebase Admin SDK & Web FCM
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=
FIREBASE_VAPID_KEY=

